# Kigoma Online Result Management System — Super Admin Frontend
# Copy this file to .env and adjust for your environment.

# Base URL of the PHP API. In development, vite.config.js proxies /api to
# http://localhost:8000 (run: php -S localhost:8000 -t public).
# For production, set the full base URL, e.g. https://api.kigoma-education.go.tz/api
VITE_API_URL=/api

# Application name shown in the Super Administrator shell.
VITE_APP_NAME=Kigoma Online Result Management System

# Demo mode flag. When true, the frontend uses in-memory demo data instead of
# calling the PHP API. Set to false once the backend is integrated.
VITE_DEMO_MODE=true
